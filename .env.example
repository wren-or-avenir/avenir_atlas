# 客户端运行时读取的变量使用 PUBLIC_ 前缀（Astro 约定，会暴露到浏览器）

# 天气 Provider：mock | qweather（qweather 未实现）
PUBLIC_WEATHER_PROVIDER=mock
# mock 天气参数：sunny | cloudy | rain | storm | typhoon | snow
PUBLIC_WEATHER_MOCK_CONDITION=sunny
# mock 风速（km/h，非负数）
PUBLIC_WEATHER_MOCK_WIND=8

# 歌单 Provider：mock | netease（netease 未实现；后续可能改为固定音频文件上传）
PUBLIC_MUSIC_PROVIDER=mock

# Notion 同步（待接入）：Internal Integration Token，从 notion.so/my-integrations 获取
# 仅构建时使用，不需要 PUBLIC_ 前缀
NOTION_API_KEY=
